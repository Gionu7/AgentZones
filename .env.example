# copy to .env and adjust; docker compose reads it automatically
ZONE_NAME=my-zone
ZONE_URL=http://my-host.corp.example:7700
ZONE_SEED=http://other-host.corp.example:7700
ZONE_SECRET=change-me-shared-by-all-zones
ZONE_API_TOKEN=
ZONE_PROFILE=uniform
MODEL_NAME=qwen2.5:1.5b
# corporate proxy for pulling images/models (the zone itself also uses it)
HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=localhost,127.0.0.1,ollama,zone
