# Settings for scripts/zone.sh. Copy to zones/<zone>/.env (docker compose reads it from there) or export them.

# --- zone az (hub)
GATEWAY_BIND=127.0.0.1          # 0.0.0.0 on the Azure VM, so spokes can reach port 9090
ZONE_B_TOKEN=                   # agentzone token   (python -m agentzones.cli token)
ZONE_CN_TOKEN=

# --- zones b and cn (spokes)
HUB_URL=http://<az-host>:9090
HUB_TOKEN=                      # this spoke's own token, the same value as ZONE_<SPOKE>_TOKEN on the hub
HUB_PROXY=                      # zone b: http://<proxy>:<port>

# --- all zones
ZONE_API_TOKEN=                 # optional bearer token for the local API
AGENT_BLAS_THREADS=2            # numpy threads per agent
HOST_CA_BUNDLE=                 # CA bundle of a TLS-inspecting proxy, for agents' HTTPS downloads
AGENT_HTTPS_PROXY=              # agents' proxy for downloads (MNIST, Ollama models)
MODEL_NAME=qwen2.5:1.5b         # with COMPOSE_PROFILES=llm
